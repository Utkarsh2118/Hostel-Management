# =============================================================================
# HostelHub — Institutional Environment Configuration Template
# Never commit real secrets. Keep all server secrets strictly server-side.
# =============================================================================

# Deployment Environment Mode: development | staging | production
HOSTELHUB_ENV="development"

# Public Application URL (non-secret)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Institutional Email Domain Restriction (for student registration)
ALLOWED_EMAIL_DOMAIN="univ.edu.in"

# Server-Side Session HMAC Signing Key (32+ random bytes in staging/production;
# leave empty in local dev to generate an ephemeral in-memory key on boot)
SESSION_SECRET=""

# -----------------------------------------------------------------------------
# Database & Authentication (Supabase PostgreSQL — Server-Side Only for Secrets)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# -----------------------------------------------------------------------------
# Official University Student Verification Provider (Required for Production)
# -----------------------------------------------------------------------------
UNIVERSITY_VERIFICATION_PROVIDER="mock_dev_only"
UNIVERSITY_API_BASE_URL=""
UNIVERSITY_API_CLIENT_ID=""
UNIVERSITY_API_CLIENT_SECRET=""
UNIVERSITY_API_KEY=""

# -----------------------------------------------------------------------------
# AI Providers (Assistant Only — Never Used for Allotment, Eligibility, or Auth)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
GROQ_API_KEY=""

# -----------------------------------------------------------------------------
# Transactional Email, SMS & Background Jobs
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
SMS_PROVIDER_API_KEY=""
BACKGROUND_JOB_SECRET=""

# -----------------------------------------------------------------------------
# Payment Gateway Abstraction (Sandbox Mode Until Institutionally Approved)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER_MODE="sandbox"
PAYMENT_PROVIDER_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Observability & Error Monitoring
# -----------------------------------------------------------------------------
SENTRY_DSN=""

# -----------------------------------------------------------------------------
# Optional Local Development Demo Credentials ONLY
# NEVER set default privileged credentials in production.
# If left blank in development, use the one-time locked Initial Setup on /login.
# -----------------------------------------------------------------------------
DEMO_ADMIN_PASSWORD=""
DEMO_WARDEN_PASSWORD=""
DEMO_MAINTENANCE_PASSWORD=""
DEMO_STUDENT_PASSWORD=""
